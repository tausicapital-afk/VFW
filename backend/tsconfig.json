{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2022",
    "lib": ["ES2022"],
    "moduleResolution": "node",
    "declaration": false,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": "./",
    // NOT incremental, on purpose. nest-cli.json sets `deleteOutDir: true`, so
    // every build wipes dist/ — but a .tsbuildinfo left behind still claims those
    // outputs exist, so tsc reports "Found 0 errors" and emits nothing. The app
    // then dies with `Cannot find module dist/main`. Incremental state and a
    // deleted outDir cannot both be trusted; correctness wins over a few seconds.
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
